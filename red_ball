import cv2
import numpy as np
import time

# --------------------- Setup HSV Trackbars ---------------------
def setup_hsv_trackbars():
    cv2.namedWindow("HSV Trackbars")
    cv2.createTrackbar("H Min", "HSV Trackbars", 00, 179, lambda x: None)
    cv2.createTrackbar("H Max", "HSV Trackbars", 20, 179, lambda x: None)
    cv2.createTrackbar("S Min", "HSV Trackbars", 68, 255, lambda x: None)
    cv2.createTrackbar("S Max", "HSV Trackbars", 255, 255, lambda x: None)
    cv2.createTrackbar("V Min", "HSV Trackbars", 160, 255, lambda x: None)
    cv2.createTrackbar("V Max", "HSV Trackbars", 255, 255, lambda x: None)

# --------------------- Read HSV from Trackbars ---------------------
def get_hsv_from_trackbars():
    h_min = cv2.getTrackbarPos("H Min", "HSV Trackbars")
    h_max = cv2.getTrackbarPos("H Max", "HSV Trackbars")
    s_min = cv2.getTrackbarPos("S Min", "HSV Trackbars")
    s_max = cv2.getTrackbarPos("S Max", "HSV Trackbars")
    v_min = cv2.getTrackbarPos("V Min", "HSV Trackbars")
    v_max = cv2.getTrackbarPos("V Max", "HSV Trackbars")
    return np.array([h_min, s_min, v_min]), np.array([h_max, s_max, v_max])

# --------------------- Circle Filtering ---------------------
def filter_contours(contours):
    best_circle = None
    best_score = 0  # Combine size and shape

    for contour in contours:
        area = cv2.contourArea(contour)
        if area < 400:
            continue

        ((cx, cy), radius) = cv2.minEnclosingCircle(contour)
        if radius < 10 or radius > 100:
            continue

        perimeter = cv2.arcLength(contour, True)
        if perimeter == 0:
            continue

        circularity = 4 * np.pi * area / (perimeter * perimeter)

        # Score using area and how round it is
        score = area * (circularity ** 1.5)  # Slight boost to circular shapes

        if score > best_score:
            best_score = score
            best_circle = (int(cx), int(cy), int(radius))

    return [best_circle] if best_circle else []



# --------------------- Ball Detection ---------------------
def detect_orange_ball_on_frame(frame, lower_orange, upper_orange):
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Orange color mask
    mask_orange = cv2.inRange(hsv, lower_orange, upper_orange)

    # Remove skin tones
    lower_skin = np.array([0, 20, 60])
    upper_skin = np.array([20, 170, 255])
    mask_skin = cv2.inRange(hsv, lower_skin, upper_skin)
    mask = cv2.bitwise_and(mask_orange, cv2.bitwise_not(mask_skin))

    # Clean up the mask
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
    mask = cv2.GaussianBlur(mask, (5, 5), 0)

    contours, _ = cv2.findContours(mask.copy(), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    circles = filter_contours(contours)
    return circles, hsv, mask

# --------------------- Draw Results ---------------------
def draw_circles_on_frame(frame, circles):
    for x, y, r in circles:
        cv2.circle(frame, (x, y), r, (0, 255, 0), 2)  # Green outer circle
        cv2.circle(frame, (x, y), 2, (0, 0, 255), 3)  # Red center dot

# --------------------- Main Program ---------------------
def main():
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("Error: Could not open camera.")
        return

    setup_hsv_trackbars()

    while True:
        ret, frame = cap.read()
        if not ret or frame is None:
            break

        start_time = time.time()
        lower_orange, upper_orange = get_hsv_from_trackbars()
        circles, hsv, mask = detect_orange_ball_on_frame(frame, lower_orange, upper_orange)

        draw_frame = frame.copy()
        draw_circles_on_frame(draw_frame, circles)

        # Show windows
        cv2.imshow("Detected Orange Ball", draw_frame)
        cv2.imshow("HSV", hsv)
        cv2.imshow("Mask after Skin Subtraction", mask)

        # FPS display
        fps = 1.0 / (time.time() - start_time)
        cv2.putText(draw_frame, f"FPS: {fps:.1f}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

        # Exit on 'q' or ESC
        key = cv2.waitKey(1) & 0xFF
        if key == ord('q') or key == 27:
            break

    cap.release()
    cv2.destroyAllWindows()

# --------------------- Run ---------------------
if __name__ == "__main__":
    main()
